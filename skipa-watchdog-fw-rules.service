[Unit]
Description=Install skipa-watchdog firewall rules (SKIPA-BLOCK + CONN logging: INPUT + DOCKER-USER + KUBE-*)
After=docker.service
Requires=docker.service
# Если на узле есть ещё и kubelet, тоже дождёмся его (юнит должен существовать -
# на серверах без k8s этот After просто ни на что не влияет)
After=kubelet.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Ставится/обновляется install.sh; поправьте путь, если разместили проект вручную
ExecStart=/opt/skipa_watchdog/install-firewall-rules.sh

[Install]
WantedBy=multi-user.target
