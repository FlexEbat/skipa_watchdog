[Unit]
Description=Periodic timer for skipa-watchdog-sync-lists (interval set in config.yaml, sources.update_interval_days)

[Timer]
# Реальный интервал (в днях) задаётся sources.update_interval_days в config.yaml,
# но systemd-таймеры не умеют читать произвольные конфиги - install.sh при
# установке подставляет сюда OnUnitActiveSec с нужным значением. Значение
# ниже - запасное по умолчанию (раз в неделю), если install.sh почему-то
# его не подставил.
OnBootSec=10min
OnUnitActiveSec=7d
Persistent=true

[Install]
WantedBy=timers.target
