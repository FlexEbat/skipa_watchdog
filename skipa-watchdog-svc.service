[Unit]
Description=Skipa Watchdog (service mode) - lightweight scanner-connection logger, no Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Ставится/обновляется install.sh; поправьте путь, если разместили проект вручную
WorkingDirectory=/opt/skipa_watchdog
ExecStart=/opt/skipa_watchdog/venv-svc/bin/python /opt/skipa_watchdog/watchdog_service.py /opt/skipa_watchdog/service.yaml
Restart=always
RestartSec=10

# Нужны права на чтение чужих сокетов в /proc/net и запись в /var/log/skipa_watchdog
# (см. README). Если не хотите запускать от root - раскомментируйте капабилити ниже
# и убедитесь, что пользователь/группа владеют /var/log/skipa_watchdog.
# User=skipa
# Group=skipa
# AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
# CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
