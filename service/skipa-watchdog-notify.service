[Unit]
Description=Skipa Watchdog (service mode) - tails kernel log into detections.log
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/skipa_watchdog
ExecStart=/usr/bin/env bash /opt/skipa_watchdog/service/notify-tail.sh /opt/skipa_watchdog/service.conf
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
