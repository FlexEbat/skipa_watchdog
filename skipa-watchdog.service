[Unit]
Description=Skipa Watchdog - monitors, blocks and (optionally) notifies via Telegram
After=network-online.target
Wants=network-online.target
# Если на хосте есть Docker - стартуем после него (чтобы DOCKER-USER уже
# существовал); на серверах без Docker этот After ни на что не влияет.
After=docker.service

[Service]
Type=simple
# Ставится/обновляется install.sh; поправьте путь, если разместили проект вручную
WorkingDirectory=/opt/skipa_watchdog
ExecStart=/opt/skipa_watchdog/venv/bin/python /opt/skipa_watchdog/watchdog.py /opt/skipa_watchdog/config.yaml
Restart=always
RestartSec=10

# Сервис работает от root: ему нужны iptables/ipset (блокировка и правила firewall),
# чтение /proc/net (в том числе conntrack), запись в /var/log/skipa_watchdog и в
# каталог установки.
User=root

# --- Ограничения (безопасные для iptables/ipset/conntrack/fail2ban) ----------------
# Намеренно НЕ включены ProtectKernelModules/ProtectKernelTunables/ProtectSystem=strict:
# iptables подгружает модули ядра, а строгая файловая система ломала запуск на части
# систем. Запись нужна только в каталог установки, /var/log/skipa_watchdog и /run.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
