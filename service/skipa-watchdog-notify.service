[Unit]
Description=Skipa Watchdog (service mode) - tails kernel log into detections.log
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/skipa_watchdog
ExecStart=/usr/bin/env bash /opt/skipa_watchdog/service/notify-tail.sh /opt/skipa_watchdog/config.yaml
Restart=always
RestartSec=10

# --- Ограничения (безопасные для iptables/ipset/conntrack/fail2ban) ----------------
# Намеренно НЕ включены ProtectKernelModules/ProtectKernelTunables/ProtectSystem=strict:
# iptables подгружает модули ядра, а строгая файловая система ломала запуск на части
# систем. Запись нужна только в каталог установки, /var/log/skipa_watchdog и /run.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
